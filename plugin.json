{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "netease-music",
  "version": "0.3.1",
  "description": "使用网易云音乐官方 CLI 搜索音乐、读取个人音乐库和管理歌单。",
  "author": {
    "name": "LastDreamTeam"
  },
  "repository": "https://github.com/LastDreamTeam/LDAI_NetEaseMusicMCP",
  "homepage": "https://github.com/LastDreamTeam/LDAI_NetEaseMusicMCP",
  "license": "AGPL-3.0-only",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "网易云音乐",
        "shortDescription": "搜索音乐和维护个人歌单",
        "longDescription": "使用网易云音乐官方 CLI 搜索音乐、读取个人音乐库和管理歌单。",
        "developerName": "LastDreamTeam",
        "category": "Entertainment",
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": [
          "检查网易云授权并查看我的歌单"
        ]
      },
      "requires_local_executor": true
    }
  }
}
